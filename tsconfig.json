{
    "compilerOptions": {
        "target": "ES2020", // Para melhor compatibilidade com async/await, etc.
        "module": "ESNext", // Melhor para usar `import` / `export` nativo
        "moduleResolution": "Node",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true // Permite importar JSON se precisar futuramente
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}